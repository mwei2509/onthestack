{
  "name": "onthestack",
  "private": true,
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "cli:build": "pnpm --filter @onthestack/cli build",
    "cli:link": "pnpm --filter @onthestack/cli build && mkdir -p ~/.local/bin && ln -sf \"$PWD/packages/cli/dist/index.js\" ~/.local/bin/stx"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
