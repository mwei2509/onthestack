{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "onthestack",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "onthestack.gg", "custom_domain": true }],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME", "class_name": "Game" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Game"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onthestack",
      "database_id": "d4b62e3a-005f-46ef-98a0-1c00ac12319f",
      // What `d1 migrations apply --preview` targets: the database every Preview binds below.
      "preview_database_id": "0609b2d5-d479-4d7c-b67f-25df8017407d"
    }
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "onthestack-card-images" }],
  // Slows down anyone sweeping join codes (ADR 0095) or hammering passkey sign-in (ADR 0103).
  "ratelimits": [
    { "name": "JOIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  // Previews don't inherit production bindings; repeat each one here.
  "previews": {
    "vars": { "TEST_PHASE": "true" },
    "durable_objects": {
      "bindings": [{ "name": "GAME", "class_name": "Game" }]
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "onthestack-preview",
        "database_id": "0609b2d5-d479-4d7c-b67f-25df8017407d"
      }
    ],
    "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "onthestack-card-images" }],
    "ratelimits": [
      { "name": "JOIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
      { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
    ]
  },
  // On while we're testing: every event is logged and players see "Something's wrong?" (ADR 0116, 0118).
  "vars": { "TEST_PHASE": "true" },
  // Workers Logs: each interpretation's log line (ADR 0108). Free within the Workers Free plan's daily allowance.
  "observability": { "enabled": true },
  "dev": { "port": 8790 }
}
