{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "onthestack",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "onthestack.gg", "custom_domain": true }],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME", "class_name": "Game" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Game"] }],
  // Previews don't inherit production bindings; repeat each one here.
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "GAME", "class_name": "Game" }]
    }
  },
  "dev": { "port": 8790 }
}
