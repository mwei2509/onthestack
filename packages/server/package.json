{
  "name": "@onthestack/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./protocol": "./src/protocol.ts",
    "./accounts": "./src/accounts/api.ts",
    "./decks": "./src/decks/api.ts",
    "./decks/parse": "./src/decks/parse.ts"
  },
  "scripts": {
    "dev": "wrangler d1 migrations apply DB --local -y && wrangler dev --var LOCAL_DEV:true",
    "db:migrate": "wrangler d1 migrations apply DB --local -y",
    "typegen": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "postinstall": "node scripts/seed.mjs install",
    "seed:load": "node scripts/seed.mjs load",
    "seed:save": "node scripts/seed.mjs save"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "@onthestack/engine": "workspace:^",
    "@onthestack/interpreter": "workspace:^",
    "@simplewebauthn/server": "14.1.0",
    "zod": "^4.6.6"
  }
}
